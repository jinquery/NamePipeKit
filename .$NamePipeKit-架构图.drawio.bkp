  <diagram name="请求流程" id="request-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="一次请求的完整流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- 客户端泳道 -->
        <mxCell id="client-swim" value="客户端" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="400" height="800" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="InvokeAsync(&quot;calc.add&quot;, 1, 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="40" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="PipeClient 构造 Request 帧&#xa;（Header + Body 序列化）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="110" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="加入请求队列&#xa;（BlockingCollection）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="190" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Worker 线程从队列取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="270" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="codec.Write(stream, frame)&#xa;【同步写 · 不 Flush】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="340" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="codec.Read(stream)&#xa;【同步读】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="550" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="TCS.TrySetResult(frame)&#xa;（RunContinuationsAsynchronously）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="640" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="await 返回 → 反序列化 Data → 返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="client-swim">
          <mxGeometry x="50" y="720" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- 传输介质 -->
        <mxCell id="pipe" value="Windows Named Pipe&#xa;（内核缓冲区）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- 服务端泳道 -->
        <mxCell id="server-swim" value="服务端" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="400" height="800" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Accept 专用线程 × 32&#xa;WaitForConnection（同步阻塞）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="40" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="每连接开专用线程&#xa;（PipeConn-xxxxxxxx）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="120" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="codec.Read(stream)&#xa;【同步读】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="340" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="反序列化 → 构造 PipeRequest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="420" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Pipeline(ctx)&#xa;Exception → Logging → Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="490" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="HandlerRegistry.Resolve(ContentType)&#xa;CallMethodHandler.HandleAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="570" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Invoker(service, args) → 返回值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="650" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="构造 Response 帧 → codec.Write&#xa;【同步写 · 不 Flush】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="server-swim">
          <mxGeometry x="50" y="710" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- 流程连接 -->
