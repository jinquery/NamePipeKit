        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="NamePipeKit 协议帧格式（大端序）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <mxCell id="row1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="1400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="f-magic" value="Magic&#xa;2 B&#xa;0x50 0x50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-ver" value="Version&#xa;1 B&#xa;=1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="80" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-flags" value="Flags&#xa;1 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="80" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-msgtype" value="MessageType&#xa;1 B&#xa;1-9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-seq" value="SequenceId&#xa;8 B（大端）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-hlen" value="HeaderLength&#xa;4 B（大端）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-blen" value="BodyLength&#xa;4 B（大端）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-header" value="Header&#xa;N B（UTF-8 JSON）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-body" value="Body&#xa;M B（UTF-8 JSON / 二进制）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f-crc" value="CRC32&#xa;4 B&#xa;对 Header+Body 计算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1380" y="120" width="120" height="120" as="geometry" />
        </mxCell>

        <!-- 偏移标注 -->
        <mxCell id="offset-label" value="偏移: 0 → 2 → 3 → 4 → 5 → 13 → 17 → 21 → 21+N → 21+N+M → 21+N+M+4" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="1400" height="30" as="geometry" />
        </mxCell>

        <!-- 固定头标识 -->
        <mxCell id="fixed-header-label" value="固定头 21 字节" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fixed-arrow" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#CC0000;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="350" y="110" as="sourcePoint" />
            <mxPoint x="350" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 额外开销标识 -->
        <mxCell id="overhead-label" value="每帧固定开销 25 字节（21 固定头 + 4 CRC）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#006699;" vertex="1" parent="1">
          <mxGeometry x="450" y="310" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- 消息类型表 -->
        <mxCell id="msgtype-title" value="MessageType 枚举" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-1" value="1  Request             客户端 → 服务端，业务请求" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-2" value="2  Response            服务端 → 客户端，业务响应" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="455" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-3" value="3  Heartbeat           双向心跳保活" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-4" value="4  Handshake           协议协商（预留）" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="525" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-5" value="5  Error               协议级错误" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-6" value="6  Cancel              取消请求（预留）" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="595" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-7" value="7  ServerPush          服务端主动推送" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-8" value="8  ResponseChunk       流式响应数据块" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="665" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mt-9" value="9  ResponseEnd         流式响应结束" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- 状态码表 -->
        <mxCell id="status-title" value="状态码" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-1" value="0000  成功" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="420" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-2" value="1000  请求格式错误" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="455" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-3" value="1001  请求数据为空" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="490" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-4" value="1002  不支持的 ContentType" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="525" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-5" value="2000  方法不存在" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="560" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-6" value="3000  参数绑定失败" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="595" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-7" value="3001  方法调用失败" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="630" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-8" value="5000  服务端内部错误" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="665" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-9" value="5001  传输层错误" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="700" width="500" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="线程模型" id="thread-model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title4" value="NamePipeKit 线程模型（50 并发 · 132 线程）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- 服务端 -->
        <mxCell id="srv-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="700" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="srv-title" value="服务端进程（独立）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#2D6A2D;" vertex="1" parent="1">
          <mxGeometry x="110" y="110" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Accept 线程 -->
        <mxCell id="accept-group" value="Accept 专用线程 × 32（DefaultWaitSlotCap）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="160" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="accept-thread" value="while (true):&#xa;  stream = CreateServerStream()&#xa;  stream.WaitForConnection()  ← 同步阻塞&#xa;  new Thread(HandleConnection).Start()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;fontSize=12;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="130" y="200" width="600" height="100" as="geometry" />
        </mxCell>

        <!-- 连接线程 -->
        <mxCell id="conn-group" value="连接专用线程 × N（每连接一个）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="330" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="conn-t1" value="PipeConn-0001&#xa;while: Read/处理/Write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="370" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="conn-t2" value="PipeConn-0002&#xa;while: Read/处理/Write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="370" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="conn-t3" value="PipeConn-0003&#xa;while: Read/处理/Write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="conn-tdots" value="…&#xa;（共 50 个）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="370" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- ThreadPool 状态 -->
        <mxCell id="srv-tp" value="ThreadPool：接近空闲（仅处理 TCS continuation 和 Task.Run）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="500" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- 服务端线程总数 -->
        <mxCell id="srv-total" value="服务端线程数：32 + 50 = 82 线程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="600" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- 客户端 -->
        <mxCell id="cli-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="700" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="cli-title" value="客户端进程（独立 / 压测内嵌）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1B4F9C;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Worker 线程 -->
        <mxCell id="worker-group" value="Worker 专用线程 × N（每 PipeClient 一个）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="worker-t1" value="PipeWorker-0001&#xa;while: Take/Write/Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="worker-t2" value="PipeWorker-0002&#xa;while: Take/Write/Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="200" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="worker-t3" value="PipeWorker-0003&#xa;while: Take/Write/Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="200" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="worker-tdots" value="…&#xa;（共 50 个）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="200" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- Worker 内部细节 -->
        <mxCell id="worker-detail-title" value="Worker 内部状态机" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="310" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="worker-detail" value="from queue.Take() in queue:&#xa;  if IsStream:&#xa;    codec.Write()&#xa;    while ResponseChunk: onChunk()&#xa;    ResponseEnd: TCS.TrySetResult()&#xa;  else:&#xa;    codec.Write()&#xa;    codec.Read()  ← 同步读&#xa;    TCS.TrySetResult(Response)&#xa;  ServerPush: PushReceived()&#xa;  Heartbeat: 忽略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;fontSize=12;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="880" y="350" width="620" height="180" as="geometry" />
        </mxCell>

        <!-- 客户端 ThreadPool -->
        <mxCell id="cli-tp" value="ThreadPool：仅处理 TCS continuation&#xa;（RunContinuationsAsynchronously）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="560" width="620" height="60" as="geometry" />
        </mxCell>

        <!-- 客户端线程总数 -->
        <mxCell id="cli-total" value="客户端线程数：50 Worker = 50 线程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="650" width="620" height="40" as="geometry" />
        </mxCell>

        <!-- 总线程数 -->
        <mxCell id="total" value="合计：82 + 50 = 132 线程（内嵌模式下 100+ 线程同进程）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontSize=16;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note" value="提示：Windows 默认时间片 15.6ms，132 线程竞争会显著增加每次调度的等待时间。&#xa;这就是 QPS 从裸测 31825 下降到 937 的物理原因——不是代码 bug，是调度开销。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=13;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="1000" width="1000" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>